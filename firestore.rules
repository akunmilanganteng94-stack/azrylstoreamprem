rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Koleksi Pengguna (Users & Saldo)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Koleksi Tiket Deposit & Bukti Transfer
    match /deposits/{depositId} {
      allow read, write: if true;
    }

    // Koleksi Pesanan Alight Motion & Lisensi
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Koleksi Riwayat Transaksi Saldo
    match /transactions/{txId} {
      allow read, write: if true;
    }

    // Koleksi Pengaturan Toko (Harga, Status Buka/Tutup, No Rekening/QRIS)
    match /settings/{docId} {
      allow read, write: if true;
    }

    // Default deny untuk koleksi tidak terdaftar
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
